# Inference Engine
INFERENCE_HOST_ADDRESS="" # Address in you base URL i.e 'http://localhost'
INFERENCE_HOST_PORT=""    # Port in in you base URL, leave blan if no port
LOCAL_API_KEY_VAR=""      # Name of the variable in this file that caries the API key you would like to use i.e 'LOCAL_API_KEY'
API_VERSION=""            # API version in you base URL i.e 'v1'
LLM_MODEL=""              # Name of the LLM model i.e 'google/gemma4'
LLM_CAPABILITIES=""       # List of model's capabilities i.e "['vision', 'tool']"
# User interface Access
CHAINLIT_AUTH_SECRET=""   # To be generated by Chainlit
ADMIN_PASSWORD_HASH=""    # To be generate by user
