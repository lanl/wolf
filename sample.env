# Put your API Keys here
LOCAL_API_KEY=""
LANL_AIPORTAL_API_KEY=""
LANL_SAMBA_API_KEY=""
LANL_VENADO_API_KEY=""
DARWIN_VLLM_API_KEY=""

# Below are the different ways you can sepecify inference engine and LLM config:
## 1. Inference Engine
INFERENCE_ENGINE_TYPE="openai"
INFERENCE_HOST_ADDRESS="http://localhost" # Address in you base URL i.e 'http://localhost'
INFERENCE_HOST_PORT=""                    # Port in in you base URL, leave blank if no port
LOCAL_API_KEY_VAR="LOCAL_API_KEY"         # Name of the variable in this file that caries the API key you would like to use i.e 'LOCAL_API_KEY'
API_VERSION="v1"                          # API version in you base URL i.e 'v1' for http://localhost:8000/v1
LLM_MODEL=""                              # Name of the LLM model i.e 'google/gemma4'
LLM_CAPABILITIES="['text','tool']"        # List of model's capabilities i.e "['vision', 'tool']"

## 2.  Optional multi-LLM configuration. If any LLM_N_* entries are provided, they
## override the single LLM_* settings above and create one agent per entry.
## The first entry becomes the main agent; later entries become worker agents.
## Missing per-entry provider fields inherit the single/default provider settings.
#LLM_1_NAME="main"
#LLM_1_MODEL=""
#LLM_1_HOST_ADDRESS="http://localhost"
#LLM_1_HOST_PORT=""
#LLM_1_LOCAL_API_KEY_VAR="LOCAL_API_KEY"
#LLM_1_API_VERSION="v1"
#LLM_1_CAPABILITIES="['text','tool']"
#LLM_1_CTX_WINDOW_LENGTH=""
#LLM_2_NAME="worker"
#LLM_2_MODEL=""
#LLM_2_HOST_ADDRESS="http://localhost"
#LLM_2_HOST_PORT=""
#LLM_2_LOCAL_API_KEY_VAR="LOCAL_API_KEY"
#LLM_2_API_VERSION="v1"
#LLM_2_CAPABILITIES="['text']"
#LLM_2_CTX_WINDOW_LENGTH=""

## 3.  Alternative multi-LLM form: provide a JSON object or list. LLMS_JSON takes
# precedence over LLM_N_* entries when set. Keep this on one line in .env.
#LLMS_JSON='{ "main": {"model": "model-a", "host": "http://localhost", "api_key_var": "LOCAL_API_KEY", "api_version": "v1", "capabilities": ["text", "tool"]}, "worker": {"model": "model-b", "host": "http://localhost", "api_key_var": "LOCAL_API_KEY", "api_version": "v1", "capabilities": ["text"]} }'

## 4.  Alternative multi-LLM form: provide a JSON file reader for file at the path given by LLMS_JSON_FILE.
# LLMS_JSON_FILE  takes precedence over LLMS_JSON when set. Keep this on one line in .env.
# LLMS_JSON_FILE="./llms.json"


# User interface Access
CHAINLIT_AUTH_SECRET=""                   # To be generated by Chainlit
ADMIN_PASSWORD_HASH=""                    # To be generate by user

